sha256sums=('SKIP')\
\
build() {\
    cd "$srcdir/maxi-player"\
    make\
}\
\
package() {\
    cd "$srcdir/maxi-player"\
\
    install -Dm755 maxi-player \\
        "$pkgdir/usr/bin/maxi-player"\
\
    install -Dm644 LICENSE \\
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"\
}\
EOF
