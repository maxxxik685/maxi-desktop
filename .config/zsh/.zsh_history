#include "search.h"\
\
#include <ctype.h>\
#include <string.h>\
\
/*\
 * Ѓ�егистр не у�у�иту�ваетсу�.\
 *\
 * Ѓ�ажно:\
 * ру�сский и английский алу�авиту� Ѓ�Ѓ� су�итау�тсу� одинакову�ми.\
 *\
 * Ѓ�апример:\
 *   "ram" -> иу�ет "Rammstein"\
 *   "рам" -> иу�ет толу�ко ру�сские названиу�\
 */\
\
/*\
 * Ѓ�ереводим ASCII-символ в нижний регистр.\
 * Ѓ�лу� UTF-8 ру�сскиу� бу�кв ниу�его мену�ту� не ну�жно:\
 * UTF-8 кодировка заглавной и строу�ной ру�сской бу�кву�\
 * отлиу�аетсу� дву�му� байтами, поу�тому� ниже есту� отделу�нау�\
 * обработка кириллиу�у�.\
 */\
static int ascii_lower(unsigned char c)\
{\
    if (c >= 'A' && c <= 'Z')\
        return c + ('a' - 'A');\
\
    return c;\
}\
\
\
/*\
 * Ѓ�озврау�ает длину� UTF-8 символа.\
 */\
static int utf8_char_length(unsigned char c)\
{\
    if (c < 0x80)\
        return 1;\
\
    if ((c & 0xE0) == 0xC0)\
        return 2;\
\
    if ((c & 0xF0) == 0xE0)\
        return 3;\
\
    if ((c & 0xF8) == 0xF0)\
        return 4;\
\
    return 1;\
}\
\
\
/*\
 * Ѓ�у�сскау� бу�ква UTF-8:\
 *\
 * Ѓ�0 90 - Ѓ�0 Ѓ�Я\
 * Ѓ�1 80 - Ѓ�1 8F\
 *\
 * Ѓ�десу� приводим толу�ко кириллиу�у� к нижнему� регистру�.\
 */\
static int utf8_lower_char(\
    const unsigned char *src,\
    unsigned char *dst\
)\
{\
    unsigned char a = src[0];\
    unsigned char b = src[1];\
\
    if (a == 0xD0)\
    {\
        /*\
         * Ѓ�-Ѓ�: D0 90 - D0 AF\
         * а-п: D0 B0 - D0 BF\
         */\
        if (b >= 0x90 && b <= 0x9F)\
        {\
            dst[0] = 0xD0;\
            dst[1] = b + 0x20;\
            return 2;\
        }\
\
        /*\
         * Ѓ�-Я: D0 A0 - D0 AF\
         * р-у�: D1 80 - D1 8F\
         */\
        if (b >= 0xA0 && b <= 0xAF)\
        {\
            dst[0] = 0xD1;\
            dst[1] = b - 0x20;\
            return 2;\
        }\
\
        /*\
         * Ё: D0 81\
         */\
        if (b == 0x81)\
        {\
            dst[0] = 0xD1;\
            dst[1] = 0x91;\
            return 2;\
        }\
    }\
\
    /*\
     * у� у�же нижний регистр.\
     */\
    if (a == 0xD1 && b == 0x91)\
    {\
        dst[0] = a;\
        dst[1] = b;\
        return 2;\
    }\
\
    /*\
     * Уже строу�нау� кириллиу�а.\
     */\
    if (a == 0xD0 && b >= 0xB0 && b <= 0xBF)\
    {\
        dst[0] = a;\
        dst[1] = b;\
        return 2;\
    }\
\
    if (a == 0xD1 && b >= 0x80 && b <= 0x8F)\
    {\
        dst[0] = a;\
        dst[1] = b;\
        return 2;\
    }\
\
    return 0;\
}\
\
\
/*\
 * Ѓ�равнение одного UTF-8 символа без у�у�у�та регистра.\
 *\
 * Ѓ�озврау�ает:\
 *   0  одинакову�е\
 *   1  разну�е\
 */\
static int utf8_char_equal(\
    const unsigned char *a,\
    const unsigned char *b\
)\
{\
    if (*a < 0x80 && *b < 0x80)\
    {\
        return ascii_lower(*a) ==\
               ascii_lower(*b);\
    }\
\
    if (*a >= 0x80 && *b >= 0x80)\
    {\
        unsigned char la[4];\
        unsigned char lb[4];\
\
        int lena =\
            utf8_lower_char(a, la);\
\
        int lenb =\
            utf8_lower_char(b, lb);\
\
        if (lena > 0 && lenb > 0)\
        {\
            if (lena != lenb)\
                return 0;\
\
            for (int i = 0; i < lena; i++)\
            {\
                if (la[i] != lb[i])\
                    return 0;\
            }\
\
            return 1;\
        }\
    }\
\
    return 0;\
}\
\
\
/*\
 * Ѓ�роверу�ет, нау�инаетсу� ли title с query.\
 */\
static int starts_with(\
    const char *title,\
    const char *query\
)\
{\
    const unsigned char *a =\
        (const unsigned char *)title;\
\
    const unsigned char *b =\
        (const unsigned char *)query;\
\
    while (*b)\
    {\
        if (!*a)\
            return 0;\
\
        int lena =\
            utf8_char_length(*a);\
\
        int lenb =\
            utf8_char_length(*b);\
\
        if (lena != lenb)\
            return 0;\
\
        if (lena == 1)\
        {\
            if (!utf8_char_equal(a, b))\
                return 0;\
        }\
        else\
        {\
            if (!utf8_char_equal(a, b))\
                return 0;\
        }\
\
        a += lena;\
        b += lenb;\
    }\
\
    return 1;\
}\
\
\
/*\
 * Ѓ�у�ет query вну�три title.\
 *\
 * Ѓ�озврау�ает позиу�иу� нау�ала совпадениу�\
 * в UTF-8 символау�.\
 *\
 * 0 = совпадение в нау�але\
 * 1+ = вну�три строки\
 * -1 = совпадениу� нет\
 */\
static int find_match(\
    const char *title,\
    const char *query\
)\
{\
    if (!*query)\
        return -1;\
\
    const unsigned char *start =\
        (const unsigned char *)title;\
\
    int character_position = 0;\
\
    while (*start)\
    {\
        const unsigned char *a = start;\
        const unsigned char *b =\
            (const unsigned char *)query;\
\
        while (*b && *a)\
        {\
            int lena =\
                utf8_char_length(*a);\
\
            int lenb =\
                utf8_char_length(*b);\
\
            if (lena != lenb)\
                break;\
\
            if (!utf8_char_equal(a, b))\
                break;\
\
            a += lena;\
            b += lenb;\
        }\
\
        if (!*b)\
            return character_position;\
\
        start +=\
            utf8_char_length(*start);\
\
        character_position++;\
    }\
\
    return -1;\
}\
\
\
/*\
 * Ѓ�у�истка состоу�ниу� поиска.\
 */\
void search_init(\
    SearchState *search\
)\
{\
    memset(\
        search,\
        0,\
        sizeof(*search)\
    );\
\
    search->active = 0;\
    search->length = 0;\
    search->result_count = 0;\
    search->selected = 0;\
}\
\
\
/*\
 * Ѓ�апу�ститу� поиск.\
 */\
void search_start(\
    SearchState *search\
)\
{\
    search->active = 1;\
    search->length = 0;\
    search->text[0] = '\0';\
\
    search->result_count = 0;\
    search->selected = 0;\
}\
\
\
/*\
 * Ѓ�становиту� поиск.\
 */\
void search_stop(\
    SearchState *search\
)\
{\
    search->active = 0;\
    search->length = 0;\
    search->text[0] = '\0';\
\
    search->result_count = 0;\
    search->selected = 0;\
}\
\
\
/*\
 * Ѓ�олносту�у� оу�иститу� строку� поиска.\
 */\
void search_clear(\
    SearchState *search\
)\
{\
    search->length = 0;\
    search->text[0] = '\0';\
    search->result_count = 0;\
    search->selected = 0;\
}\
\
\
/*\
 * Ѓ�обавиту� один байт в строку� поиска.\
 *\
 * UTF-8 намеренно принимаем побайтно:\
 * input.c отдау�т нам именно байту� терминала.\
 */\
int search_add_byte(\
    SearchState *search,\
    unsigned char byte\
)\
{\
    if (!search->active)\
        return 0;\
\
    if (byte < 32)\
        return 0;\
\
    if (byte == 127)\
        return 0;\
\
    if (search->length >=\
        SEARCH_TEXT_SIZE - 1)\
    {\
        return 0;\
    }\
\
    search->text[\
        search->length\
    ] = (char)byte;\
\
    search->length++;\
\
    search->text[\
        search->length\
    ] = '\0';\
\
    return 1;\
}\
\
\
/*\
 * Backspace.\
 *\
 * Удалу�ем весу� последний UTF-8 символ,\
 * а не толу�ко последний байт.\
 */\
void search_backspace(\
    SearchState *search\
)\
{\
    if (!search->active)\
        return;\
\
    if (search->length <= 0)\
        return;\
\
    int pos =\
        search->length - 1;\
\
    while (pos > 0 &&\
           ((unsigned char)\
                search->text[pos] & 0xC0)\
               == 0x80)\
    {\
        pos--;\
    }\
\
    search->length = pos;\
\
    search->text[pos] = '\0';\
\
    search->selected = 0;\
}\
\
\
/*\
 * Ѓ�бновиту� резу�лу�тату� поиска.\
 *\
 * Ѓ�риоритет:\
 *\
 * 1. Ѓ�азвание нау�инаетсу� с запроса.\
 * 2. Ѓ�апрос встреу�аетсу� рану�у�е.\
 * 3. Ѓ�ри одинаковом совпадении  �\
 *    алу�авитну�й пору�док у�же отсортированного\
 *    плейлиста.\
 *\
 * Ѓ� results[] кладу�м резу�лу�тату�\
 * от менее вероу�тного к более вероу�тному�.\
 *\
 * Ѓ�оу�тому�:\
 *\
 * results[0] = саму�й слабу�й\
 * results[4] = саму�й вероу�тну�й\
 */\
void search_update(\
    SearchState *search,\
    Playlist *playlist\
)\
{\
    if (!search->active)\
        return;\
\
    search->result_count = 0;\
    search->selected = 0;\
\
    if (search->length <= 0)\
        return;\
\
    typedef struct\
    {\
        int index;\
        int position;\
        int starts;\
    } Match;\
\
    Match matches[\
        PLAYLIST_MAX_TRACKS\
    ];\
\
    int count = 0;\
\
    for (int i = 0;\
         i < playlist->count;\
         i++)\
    {\
        int position =\
            find_match(\
                playlist->titles[i],\
                search->text\
            );\
\
        if (position < 0)\
            continue;\
\
        matches[count].index = i;\
        matches[count].position = position;\
        matches[count].starts =\
            position == 0;\
\
        count++;\
    }\
\
    /*\
     * Ѓ�ортировка:\
     *\
     * снау�ала совпадениу� с нау�ала,\
     * затем более ранние совпадениу�.\
     *\
     * Ѓ�тогову�й массив потом разворау�иваем,\
     * у�тобу� лу�у�у�ий бу�л снизу�.\
     */\
    for (int i = 0;\
         i < count - 1;\
         i++)\
    {\
        for (int j = i + 1;\
             j < count;\
             j++)\
        {\
            int swap = 0;\
\
            if (matches[j].starts >\
                matches[i].starts)\
            {\
                swap = 1;\
            }\
            else if (\
                matches[j].starts ==\
                matches[i].starts &&\
                matches[j].position <\
                matches[i].position)\
            {\
                swap = 1;\
            }\
\
            if (swap)\
            {\
                Match temp =\
                    matches[i];\
\
                matches[i] =\
                    matches[j];\
\
                matches[j] =\
                    temp;\
            }\
        }\
    }\
\
    /*\
     * Ѓ�еру�м максиму�м пу�ту� лу�у�у�иу�.\
     */\
    int limit = count;\
\
    if (limit > SEARCH_RESULTS)\
        limit = SEARCH_RESULTS;\
\
    /*\
     * Ѓ�азворау�иваем:\
     *\
     * сверу�у�  -> слабее\
     * снизу�   -> силу�нее\
     */\
    for (int i = 0;\
         i < limit;\
         i++)\
    {\
        search->results[i] =\
            matches[limit - 1 - i].index;\
    }\
\
    search->result_count = limit;\
\
    /*\
     * Ѓ�аму�й вероу�тну�й резу�лу�тат  �\
     * нижний.\
     */\
    search->selected =\
        limit - 1;\
}\
EOF
